# Mercado Pago > Suas integrações > Credenciais de produção > Access Token
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# (opcional) Chave secreta do webhook (Mercado Pago > Webhooks > Assinatura secreta)
MP_WEBHOOK_SECRET=
# (opcional) URL do seu site. Se vazio, usa o domínio da Vercel automaticamente.
SITE_URL=
# (opcional) Máximo de parcelas no cartão
MAX_INSTALLMENTS=12
# (opcional) Recebe cada lead e cada evento (Make, n8n, Zapier, Google Sheets...)
LEAD_WEBHOOK_URL=
# (opcional) Recebe só pagamentos APROVADOS, pra liberar o acesso
DELIVERY_WEBHOOK_URL=
